{
  "name": "enterprise-relationship-graph",
  "version": "2.1.1",
  "private": true,
  "description": "Enterprise Relationship Graph — SharePoint-hosted single source of truth for offices, systems, platforms, sites, teams, groups, and operational dependencies.",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "dev": "heft start --clean",
    "check": "npm run test:safety && heft test --clean",
    "build": "heft build --clean",
    "clean": "heft clean",
    "test": "npm run test:safety && heft test --clean",
    "test:safety": "node node_modules/typescript/bin/tsc -p tests/tsconfig.json && node temp/safety-tests/tests/run.js",
    "typecheck": "tsc -p ./ --noEmit",
    "serve": "heft start --clean",
    "ship": "npm run test:safety && heft test --clean --production && heft package-solution --production",
    "release": "npm run ship && eo-spfx preflight sharepoint/solution/enterprise-relationship-graph.sppkg",
    "test:legacy": "node scripts/smoke-test.js",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.20",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-loader": "1.23.2",
    "@microsoft/sp-page-context": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.19",
    "@types/jest": "30.0.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.2.19"
  }
}
